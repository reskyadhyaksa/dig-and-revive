option Casing = Camel
option ClientOutput = "../../client/Network/DigNetwork"
option ServerOutput = "../../server/Network/DigNetwork"

event StartDigRequest {
    From: Client,
    Type: Reliable,
    Call: SingleAsync,
    Data: (f64, string),
}

event StartMinigame {
    From: Server,
    Type: Reliable,
    Call: SingleAsync,
    Data: (string, u16, f64),
}

event SwingRequest {
    From: Client,
    Type: Reliable,
    Call: SingleAsync,
    Data: (),
}

event MinigameHit {
    From: Server,
    Type: Reliable,
    Call: SingleAsync,
    Data: (u16, u16),
}

event MinigameComplete {
    From: Server,
    Type: Reliable,
    Call: SingleAsync,
    Data: (boolean, string?, u16, u32, u32, u32, string?),
}

event DigDropVFX {
    From: Server,
    Type: Reliable,
    Call: ManyAsync,
    Data: (Instance, string),
}

event PlayerStatsSync {
    From: Server,
    Type: Reliable,
    Call: SingleAsync,
    Data: (u32, u32, u32, u32, f64),
}

event EquipItemRequest {
    From: Client,
    Type: Reliable,
    Call: SingleAsync,
    Data: string,
}

enum SellMode = { All, Held }

event SellRequest {
    From: Client,
    Type: Reliable,
    Call: SingleAsync,
    Data: SellMode,
}

event SellResult {
    From: Server,
    Type: Reliable,
    Call: SingleAsync,
    Data: (boolean, u32, u16, string?),
}

event ToggleFavoriteRequest {
    From: Client,
    Type: Reliable,
    Call: SingleAsync,
    Data: string,
}

event BuyShovelRequest {
    From: Client,
    Type: Reliable,
    Call: SingleAsync,
    Data: string(1..32),
}

event BuyShovelResult {
    From: Server,
    Type: Reliable,
    Call: SingleAsync,
    Data: (boolean, string, string?),
}

event SelectShovelRequest {
    From: Client,
    Type: Reliable,
    Call: SingleAsync,
    Data: string(1..32),
}
